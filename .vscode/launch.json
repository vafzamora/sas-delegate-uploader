    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: SasUploadApi Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build SasUpload.Api",
            "program": "${workspaceFolder}/SasUpload.Api/bin/Debug/net10.0/SasUpload.Api.dll",
            "cwd": "${workspaceFolder}/SasUpload.Api",
            "launchSettingsFilePath": "${workspaceFolder}/SasUpload.Api/Properties/launchSettings.json",
            "launchSettingsProfile": "http",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ApiSecurity__ApiKey": "valor-longo-e-aleatorio",
                "UploadStorage__AccountEndpoint": "https://sasuploadstorage.blob.core.windows.net/",
                "UploadStorage__ContainerName": "uploads",
                "UploadStorage__SasLifetimeMinutes": "5",
                "UploadStorage__MaxUploadSizeBytes": "524288000"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}